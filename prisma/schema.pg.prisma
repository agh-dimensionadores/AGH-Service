generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-pg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabla existente — no usar db push sobre esta base
model Cliente {
  id            Int              @id @default(autoincrement())
  nombre        String           @db.VarChar(100)
  empresa       String?          @db.VarChar(200)
  email         String?          @db.VarChar(200)
  token         String           @db.VarChar(100)
  activo        Int?
  fechaCreacion DateTime?        @map("fecha_creacion")
  clienteId     Int?             @map("cliente_id")
  instalaciones ClienteMaquina[]

  @@map("clientes")
}

model Maquina {
  idmachine       Int              @id @default(autoincrement())
  marca           String           @db.VarChar(100)
  modelo          String?          @db.VarChar(100)
  /// Foto del modelo (binario en PostgreSQL)
  imagen          Bytes?
  imagenMime      String?          @map("imagen_mime") @db.VarChar(50)
  imagenUpdatedAt DateTime?        @map("imagen_updated_at") @db.Timestamptz(6)
  /// Aparece de base en /maquinas (los modelos más usados)
  favorito        Boolean          @default(false)
  instalaciones   ClienteMaquina[]

  @@map("maquinas")
}

model ClienteMaquina {
  id               Int                     @id @default(autoincrement())
  idCliente        Int                     @map("id_cliente")
  idMaquina        Int                     @map("id_maquina")
  sitio            String?                 @db.VarChar(200)
  numeroSerie      String                  @unique @map("numero_serie") @db.VarChar(100)
  /// venta | alquiler
  modalidad        String                  @default("venta") @db.VarChar(20)
  fechaCompra      DateTime?               @map("fecha_compra") @db.Date
  fechaFabricacion DateTime?               @map("fecha_fabricacion") @db.Date
  fechaCreacion    DateTime?               @default(now()) @map("fecha_creacion")
  cliente          Cliente                 @relation(fields: [idCliente], references: [id])
  maquina          Maquina                 @relation(fields: [idMaquina], references: [idmachine])
  mantenimientos   ClienteMantenimiento[]
  alquileres       MaquinaAlquiler[]

  @@map("clientes_maquinas")
}

/// Períodos de alquiler de una unidad instalada.
model MaquinaAlquiler {
  id               Int            @id @default(autoincrement())
  idClienteMaquina Int            @map("id_cliente_maquina")
  /// Cliente al que se alquiló (snapshot)
  idCliente        Int            @map("id_cliente")
  fechaInicio      DateTime       @map("fecha_inicio") @db.Date
  fechaFin         DateTime       @map("fecha_fin") @db.Date
  comentario       String?
  creadoEn         DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)
  instalacion      ClienteMaquina @relation(fields: [idClienteMaquina], references: [id], onDelete: Cascade)

  @@index([idClienteMaquina])
  @@index([idCliente])
  @@map("maquinas_alquileres")
}

model ClienteMantenimiento {
  id                Int            @id @default(autoincrement())
  idClienteMaquina  Int            @map("id_cliente_maquina")
  tipo              String         @db.VarChar(50)
  descripcion       String?
  solicitado        DateTime       @default(now())
  arreglado         DateTime?
  estado            String         @default("abierto") @db.VarChar(30)
  /// Día/hora planificados para la visita (agenda admin)
  programado        DateTime?      @db.Timestamptz(6)
  /// Quién va (texto libre)
  asignadoA         String?        @map("asignado_a") @db.VarChar(150)
  /// Comentario interno de AGH al cerrar / resolver
  comentarioArreglo String?        @map("comentario_arreglo")
  instalacion       ClienteMaquina @relation(fields: [idClienteMaquina], references: [id], onDelete: Cascade)
  ordenCubiscan     CubiscanOrdenServicio?

  @@map("clientes_mantenimientos")
}

/// Planilla de Orden de Servicio CubiScan (al cerrar mantenimiento).
model CubiscanOrdenServicio {
  id               Int      @id @default(autoincrement())
  idMantenimiento  Int      @unique @map("id_mantenimiento")
  /// Campos de la planilla (checklist, cabecera, refacciones, encuesta)
  payload          Json
  firmaIngeniero   String?  @map("firma_ingeniero")
  firmaCliente     String?  @map("firma_cliente")
  emailDestino     String?  @map("email_destino") @db.VarChar(200)
  emailEnviadoEn   DateTime? @map("email_enviado_en") @db.Timestamptz(6)
  emailError       String?  @map("email_error")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  mantenimiento    ClienteMantenimiento @relation(fields: [idMantenimiento], references: [id], onDelete: Cascade)

  @@map("cubiscan_ordenes_servicio")
}

/// Login de AGH Service. No confundir con cloud_users (Voxel Cloud).
model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(200)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  nombre       String   @db.VarChar(150)
  rol          String   @db.VarChar(20)
  /// ID del cliente en la tabla clientes (sin FK)
  clienteId    Int?     @map("cliente_id")
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@index([clienteId])
  @@map("agh_usuarios")
}

/// Usuarios existentes de Voxel Cloud.
/// clienteId es la asociación con clientes.id, aunque la tabla no declara FK.
model CloudUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(200)
  fullName     String?   @map("full_name") @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String?   @default("viewer") @db.VarChar(50)
  clienteId    Int       @map("cliente_id")
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)

  @@index([clienteId])
  @@map("cloud_users")
}
