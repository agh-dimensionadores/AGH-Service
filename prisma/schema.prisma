generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL_SQLITE")
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          String
  /// ID del cliente en PostgreSQL (tabla clientes)
  clienteId    Int?
  creadoEn     DateTime @default(now())
}

model Soporte {
  id                 String   @id @default(cuid())
  clienteId          Int
  idClienteMaquina   Int?
  titulo             String
  mensaje            String
  estado             String   @default("abierto")
  creadoEn           DateTime @default(now())
}
